@@ -19,6 +19,38 @@ Default package/activity target OpenClaw Android startup.
 EOF
 }
 
+find_simpleperf_dir() {
+  if [[ -n "${ANDROID_NDK_HOME:-}" && -f "${ANDROID_NDK_HOME}/simpleperf/app_profiler.py" ]]; then
+    printf '%s\n' "${ANDROID_NDK_HOME}/simpleperf"
+    return 0
+  fi
+
+  if [[ -n "${ANDROID_NDK_ROOT:-}" && -f "${ANDROID_NDK_ROOT}/simpleperf/app_profiler.py" ]]; then
+    printf '%s\n' "${ANDROID_NDK_ROOT}/simpleperf"
+    return 0
+  fi
+
+  local sdk_roots=()
+  [[ -n "${ANDROID_SDK_ROOT:-}" ]] && sdk_roots+=("${ANDROID_SDK_ROOT}")
+  [[ -n "${ANDROID_HOME:-}" ]] && sdk_roots+=("${ANDROID_HOME}")
+  sdk_roots+=("${HOME}/Library/Android/sdk" "${HOME}/Android/Sdk")
+
+  local candidates=()
+  local sdk_root dir
+  for sdk_root in "${sdk_roots[@]}"; do
+    while IFS= read -r dir; do
+      [[ -f "$dir/app_profiler.py" ]] && candidates+=("$dir")
+    done < <(ls -d "$sdk_root"/ndk/*/simpleperf 2>/dev/null || true)
+  done
+
+  if [[ ${#candidates[@]} -gt 0 ]]; then
+    printf '%s\n' "${candidates[@]}" | sort | tail -n1
+    return 0
+  fi
+
+  return 1
+}
+
